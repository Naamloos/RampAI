DISCORD_API_TOKEN=
DISCORD_CHANNEL_ID=
BOT_ID=
OWNER_USER_ID=
AI_PROVIDER=ollama
# ollama uses http://localhost:11434/v1; LM Studio uses http://localhost:1234/v1.
# AI_BASE_URL overrides either default. AI_API_KEY is optional for local servers.
# AI_PROVIDER=lmstudio
AI_MODEL=qwen3.5:4b
# Set false to suppress private reasoning; any other value enables <think> blocks.
AI_THINK=false
AI_CONTEXT_TOKENS=16384
# Optional lower input budget; automatically capped to fit AI_CONTEXT_TOKENS.
# CONTEXT_CHAR_LIMIT=18000
AI_ATTEMPTS=1
BOT_MESSAGE_INTERVAL_MS=900000
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=rampai_memories
SYSTEM_PROMPT_PATH=system-prompt.md
CHAT_STATE_PATH=chat-state.json
CHAT_STATE_LIMIT=80
CHAT_STATE_PROMPT_LIMIT=40
RELEVANT_MEMORY_LIMIT=6
MESSAGE_LIMIT=4
WEB_SEARCH_BASE_URL=https://www.bing.com
